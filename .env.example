# 이 파일을 .env 로 복사해서 쓰세요.  cp .env.example .env
# ⚠️ .env.example 은 커밋됩니다. **키는 .env 에만** 넣으세요.

# ── 피부 스크리닝 서브에이전트 ─────────────────────────
# 가중치는 레포에 없습니다 (best.pt 가 100MB 리밋을 넘습니다).
# 허깅페이스에서 받아 씁니다 — DAENGS 개발 서버가 쓰던 바로 그 릴리스입니다.
SKIN_RELEASE_REPO=gayoniee/daengs-skin-screening-release
SKIN_RELEASE_REVISION=v1
# 2단계 앙상블 팔 수. **다르면 게이트 G4 가 판정을 막습니다.**
# 배포에서 앙상블이 조용히 1팔로 줄었던 적이 있어서 숫자로 못 박습니다.
SKIN_EXPECTED_ARMS=3
# 비워두면 릴리스를 HF 에서 받습니다. 로컬 폴더를 쓰려면 경로를 주세요.
SKIN_RELEASE_DIR=
# 가중치 없이 배선만 볼 때. 1 이면 MockAgent 로 돕니다.
SKIN_MOCK=0

# 허깅페이스 토큰 — 릴리스 레포가 private 이라 필요합니다.
#   https://huggingface.co/settings/tokens  (Read 권한이면 충분)
# `hf auth login` 을 했으면 여기는 비워둬도 됩니다 (그쪽이 우선).
HF_TOKEN=

# ── 행동 상담 RAG 서브에이전트 ─────────────────────────
# 곁에 클론된 dog-behavior-rag 의 경로. MCP 서버가 **그 레포의 venv 로** 뜹니다.
BEHAVIOR_RAG_REPO=../dog-behavior-rag
# 그 레포의 pgvector. 비워두면 그쪽 .env 를 따릅니다.
DATABASE_URL=

# ── 오케스트레이터 LLM ─────────────────────────────────
# openai-compatible 프로토콜이면 무엇이든 됩니다 (Gemini / LM Studio / Ollama / vLLM).
# ⚠️ **툴 호출(tool calling)을 지원하는 모델이어야 합니다.** 루프가 그걸로 돕니다.
# (A) Gemini 무료 티어 — 기본값. 키: https://aistudio.google.com/apikey
#     ⚠️ 3.6-flash 는 503(high demand)이 잦다. 3.1-flash-lite 가 989ms 로 답하고
#        툴 호출도 맞게 한다 — 라우팅 15/15 · 적대적 24턴이 이 모델로 잰 숫자다.
# (B) Ollama — 로컬, 키 없음. 실측(RTX 4060 8GB · 라우팅 30문항):
#       qwen3:8b       21~23/30 · 5~7초/턴  ← 로컬 기본 (2026-09-22 사용자 선택)
#       granite4.1:8b  16~18/30 · ~1초/턴   (빠르지만 행동 질문에 툴을 안 부르고 직접 답함)
#       command-r7b · qwen3.5:9b 는 툴 호출 프로브에서 탈락
#     트레이 앱의 Ollama 는 컨텍스트 4096 이라 8K 변형을 만든다:
#       ollama pull qwen3:8b
#       printf 'FROM qwen3:8b
PARAMETER num_ctx 8192
' > Modelfile && ollama create qwen3-8k -f Modelfile
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=qwen3-8k
#     LLM_API_KEY=ollama
#     로컬 7B 는 툴 하나짜리 질문엔 충분하고, 사진+상담이 한 턴에 섞이면 Gemini 가 낫다.
# (C) LM Studio — (B) 와 같은 OpenAI 호환. LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.2
# 한 응답 상한. 로컬 모델은 이게 없으면 끝없이 생성한다.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
# 429(한도)·503(과부하) 재시도. 무료 티어는 503 이 자주 납니다.
LLM_RETRIES=4
# 한 턴에 허용할 툴 호출 왕복 수. 넘으면 멈춥니다 (무한 루프 방지).
MAX_TOOL_ROUNDS=6
